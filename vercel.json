{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.1"
    }
  },
  "routes": [
    { "src": "/api/(.*)",  "dest": "/api/$1" },
    { "src": "/css/(.*)",  "dest": "/public/css/$1" },
    { "src": "/js/(.*)",   "dest": "/public/js/$1" },
    { "src": "/manifest.json", "dest": "/public/manifest.json" },
    { "src": "/sw.js", "dest": "/public/sw.js" },
    { "src": "/icon.svg", "dest": "/public/icon.svg" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
